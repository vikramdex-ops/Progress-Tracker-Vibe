{
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "/(auth|entries|employees|leaves|gamification|notifications|seed|calendar|announcements|quiz|ai|push|password-resets)(.*)",
      "dest": "/api/index.ts"
    }
  ]
}
