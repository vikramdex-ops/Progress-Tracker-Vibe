{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "echo 'API-only'",
  "outputDirectory": ".vercel/output/static",
  "functions": {
    "api/index.ts": {
      "runtime": "nodejs20.x",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.ts" }
  ]
}
